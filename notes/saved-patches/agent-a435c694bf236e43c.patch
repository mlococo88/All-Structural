-- **After:**
-  ```js
-  const SC92={A:1040e8, m:5, TH:7.0};
-  const adttSLcrossSC=SC92.A/(Math.pow(fatGRatio*SC92.TH,SC92.m)*365*lifeYr*nCyc);
